# Edge TTS backend preset (Microsoft Edge cloud via openai-edge-tts proxy)
#
# 사용법:
#   cp .env.edge-tts.example .env.edge-tts
#   docker compose --env-file .env.edge-tts up -d
#
# 전제: openai-edge-tts 가 docker 네트워크 'openai-edge-tts_default' 에서
#       호스트명 'openai-edge-tts:5050' 으로 접근 가능해야 함.
TTS_BACKEND_URL=http://openai-edge-tts:5050
TTS_TIMEOUT=120
TTS_MODEL=
TTS_MAX_RETRIES=3
