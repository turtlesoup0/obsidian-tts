# CosyVoice 3 backend preset (로컬 GPU/호스트 native 추론)
#
# 사용법:
#   cp .env.cosyvoice3.example .env.cosyvoice3
#   docker compose --env-file .env.cosyvoice3 up -d
#
# 전제: CosyVoice3 가 호스트의 5052 포트에서 OpenAI 호환 API 로 동작.
#       Linux 는 docker-compose 에 extra_hosts: ["host.docker.internal:host-gateway"] 필요.
TTS_BACKEND_URL=http://host.docker.internal:5052
TTS_TIMEOUT=180
TTS_MODEL=
TTS_MAX_RETRIES=2
# 백엔드 전환 직후 옛 캐시 HIT 차단 (안정화 후 false 로 복귀)
TTS_DISABLE_INTERNAL_CACHE=true
